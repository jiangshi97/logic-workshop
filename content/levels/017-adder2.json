{
  "id": 17,
  "title": "两位加法",
  "caption": "串联进位",
  "goal": "计算两位 A+B+Cin，Sum 保留两位，Cout 表示溢出。",
  "formula": "Sum + 4Cout = A + B + Cin",
  "chapter": 4,
  "inputs": [["A", 2], ["B", 2], ["Cin", 1]],
