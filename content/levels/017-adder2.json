  "hints": ["从最低位开始相加。", "低位全加器的 Cout 接高位全加器的 Cin。", "两个 Sum 按位序合成总线，高位 Cout 连接最终进位。"],
  "rewardName": "Adder2",
  "combinational": { "expect": { "Sum": "(A + B + Cin) mod 4", "Cout": "(A + B + Cin) div 4" } }
}
