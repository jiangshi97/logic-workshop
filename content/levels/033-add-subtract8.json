      "Borrow": "Sub = 1 ? (A < B ? 1 : 0) : 0",
      "Z": "Sub = 0 ? ((A + B) mod 256 = 0 ? 1 : 0) : ((A - B) mod 256 = 0 ? 1 : 0)"
    },
