{
  "id": 1,
  "title": "四位减法",
  "caption": "补码与借位",
  "goal": "Diff 是 A−B 的四位结果；A 小于 B 时 Borrow 为 1。",
  "formula": "Diff = (A − B) mod 16；Borrow = (A < B)",
  "chapter": 7,
  "inputs": [["A", 4], ["B", 4]],
  "outputs": [["Diff", 4]],
  "hooks": {"onFirstClear": "example/celebrate", "onFirstHint": "example/nudge", "onEveryTest": "example/coach"},
  "hints": [
    "减法可转为 A 加上 B 的反码再加 1。",
    "每一位反转 B，把初始进位设为 1。",
    "四位相加的 Sum 就是 Diff；最高位 Cout 反转后得到 Borrow。"
  ],
  "rewardName": "Subtract4",
  "combinational": { "expect": { "Diff": "(A - B) mod 16" } }
}