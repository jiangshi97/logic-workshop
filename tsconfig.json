{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "paths": { "logic-level-api": ["./packages/level-api/src/index.ts"] }
  },
  "include": ["src", "tests", "content/packs", "packages", "vite.config.ts", "playwright.config.ts"]
}
